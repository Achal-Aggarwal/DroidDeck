#!/bin/bash
android=$HOME/Storage/Download
link=$HOME/Downloads
[ -d "$android" ] && [ -w "$android" ] || exit 0
[ "$(readlink "$link" 2>/dev/null)" = "$android" ] && exit 0
free_name() {
  local name=$1 base ext n=2
  [ -e "$android/$name" ] || { echo "$name"; return; }
  base=${name%.*} ext=
  [ "$base" != "$name" ] && [ -n "$base" ] && ext=.${name##*.} || base=$name
  while [ -e "$android/$base ($n)$ext" ]; do n=$((n + 1)); done
  echo "$base ($n)$ext"
}
if [ -L "$link" ]; then
  rm -f "$link"
elif [ -d "$link" ]; then
  shopt -s dotglob nullglob
  for f in "$link"/*; do
    mv -n -- "$f" "$android/$(free_name "${f##*/}")" || exit 1
  done
  rmdir "$link" 2>/dev/null || mv "$link" "$link.old.$$" || exit 1
elif [ -e "$link" ]; then
  mv "$link" "$link.old.$$" || exit 1
fi
ln -s "$android" "$link"
